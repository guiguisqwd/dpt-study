# Dependencies, local build output, and generated release bundles
node_modules/
dist/
.vite/
.pnpm-store/
/website-release/
/tmp/
__pycache__/
*.py[cod]
.venv/
venv/
*.log
.DS_Store

# Local credentials and intermediate voice files are never project sources
.env
.env.*
!.env.example
.voice-staging/
*.pem
*.key

# Review screenshots are local evidence, not published anatomy assets
/screenshots/
/test-results/
/playwright-report/
/*.png
/*.jpg
/library/shoulder/3d/*.png
/library/shoulder/3d/*.jpg
/library/shoulder/text/build-report.json
/library/shoulder/pdf/pdf-export-report.json

# Keep the reviewed PDF as a release input; rebuild ZIPs during publication
/library/shoulder/pdf/*.zip

# Topic pages and the study home are generated from library/ by site/build/.
/library/shoulder/3d/public/topics/
/library/shoulder/3d/public/topics.json
/library/shoulder/3d/public/study.html

/library/shoulder/3d/public/topic.css
