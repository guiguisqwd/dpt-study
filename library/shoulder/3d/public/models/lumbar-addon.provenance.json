    {
      "structure": "lumbar-psoas-major-muscles",
      "showAs": "Psoas major",
      "zAnatomyName": "Psoas major",
      "why": "Same source mesh as the hip add-on's psoas major. It is exported again under a lumbar group id because an add-on id may only be used by its own chapter (QC-09)."
    },
    {
      "structure": "rotatores-muscles",
      "showAs": "Rotatores",
      "zAnatomyName": "Rotatores",
      "why": "Z-Anatomy has one rotatores mesh per side for the whole column (measured from the sacrum to the upper cervical spine), not a separate lumbar part. The chapter text describes the lumbar rotatores; the 3D shows the whole muscle group."
    },
    {
      "structure": "multifidus-lumborum-muscles",
      "showAs": "Multifidus (lumbar part)",
      "zAnatomyName": "Multifidus lumborum muscle",
      "why": "Lumbar part only; the thoracic and cervical parts are separate meshes and are not exported. The mesh spans about T12 to L4–L5 and ends about 1 cm above the sacrum, so its sacral and iliac attachments are not shown."
    },
    {
      "structure": "interspinales-lumborum-muscles",
      "showAs": "Interspinales (lumbar part)",
      "zAnatomyName": "Interspinales lumborum muscles",
      "why": "Lumbar part only (about T12–L1 down to L4–L5); the thoracic and cervical parts are separate meshes and are not exported."
    },
    {
      "structure": "intertransversarii-lumborum-muscles",
      "showAs": "Intertransversarii (lumbar, lateral)",
      "zAnatomyName": "Dorsal parts / Ventral parts of lateral intertransversarii lumborum muscles",
      "why": "Two meshes in one group. Z-Anatomy has no mesh for the medial lumbar intertransversarii, so only the lateral ones are shown."
    },
    {
      "structure": "spinalis-thoracis-muscles",
      "showAs": "Spinalis thoracis",
      "zAnatomyName": "Spinalis thoracis muscle",
      "why": "Measured span about L3 to T2, close to the midline."
    },
