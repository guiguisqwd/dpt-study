  "mappingNotes": [
    {
      "structure": "multifidus-lumborum-muscles",
      "showAs": "Multifidus (lumbar part)",
      "zAnatomyName": "Multifidus lumborum muscle",
      "why": "Z-Anatomy splits the multifidus into colli, thoracis and lumborum meshes; only the lumbar mesh is exported, as the chapter teaches the lumbar multifidus. Measured 2026-11-27: its lower end is about 1 cm above the top of the sacrum, so the sacral origin described in the text is not modelled."
    },
    {
      "structure": "rotatores-muscles",
      "showAs": "Rotatores",
      "zAnatomyName": "Rotatores",
      "why": "One mesh per side for the whole column (measured from sacrum level to above T1). The text says the rotatores are best developed in the thoracic region and that lumbar rotatores are often inconsistent; the mesh does not show that variation."
    },
    {
      "structure": "lateral-intertransversarii-lumborum-muscles",
      "showAs": "Intertransversarii (lateral lumbar group: dorsal and ventral parts)",
      "zAnatomyName": "Dorsal parts of lateral intertransversarii lumborum muscles / Ventral parts of lateral intertransversarii lumborum muscles",
      "why": "Two meshes per side in one group. Z-Anatomy has no mesh for the medial lumbar intertransversarii, so the medial group taught in the text is a model gap."
    },
    {
      "structure": "interspinales-lumborum-muscles",
      "showAs": "Interspinales (lumbar)",
      "zAnatomyName": "Interspinales lumborum muscles",
      "why": "Only the lumbar mesh is exported; Z-Anatomy also has colli and thoracis meshes."
    },
    {
      "structure": "iliocostalis-lumborum-muscles / longissimus-thoracis-muscles / spinalis-thoracis-muscles",
      "showAs": "Iliocostalis lumborum, Longissimus thoracis, Spinalis thoracis",
      "zAnatomyName": "Iliocostalis lumborum muscle / Longissimus thoracis muscle / Spinalis thoracis muscle",
      "why": "The three erector spinae parts the chapter teaches. Z-Anatomy's iliocostalis thoracis and the cervical and capitis parts are not exported."
    },
    {
      "structure": "lumbar-psoas-major-muscles",
      "showAs": "Psoas major",
      "zAnatomyName": "Psoas major",
      "why": "The same source mesh as the hip add-on's psoas major, exported again under a lumbar group id because a chapter can only use its own add-on (QC-09) and structure ids must stay unique across add-ons."
    },
    {
      "structure": "*",
      "showAs": "",
      "zAnatomyName": "",
      "why": "Hemispheres: every exported '.l' mesh lies at +x like the base skeleton's '.l' bones, so -left/-right ids match the skeleton. Measured 2026-11-27: every exported mesh except psoas major lies entirely at z < 0 (the posterior side of the model); psoas major spans z -0.041 to 0.037 and its lower end overlaps the femur."
    }
